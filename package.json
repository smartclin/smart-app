	"scripts": {
		"build": "vite build && cp instrument.server.mjs .output/server",
		"check": "biome check --write",
		"db:generate": "drizzle-kit generate",
		"db:migrate": "drizzle-kit migrate",
		"db:pull": "drizzle-kit pull",
		"db:push": "drizzle-kit push",
		"db:studio": "drizzle-kit studio",
		"dev": "ENABLE_SENTRY=false bun develop",
		"dev:sentry": "ENABLE_SENTRY=true bun develop",
		"develop": "dotenv -e .env -- sh -c \"NODE_OPTIONS='--import ./instrument.server.mjs' vite dev --port 3000\"",
		"format": "biome format --write",
		"generate": " bunx @tanstack/router-cli generate  && bun db:generate",
		"lint": "biome lint --write",
		"preview": "vite preview",
		"start": "node --import ./.output/server/instrument.server.mjs .output/server/index.mjs",
		"test": "vitest run",
		"typecheck": "tsc --noEmit --skipLibCheck"
